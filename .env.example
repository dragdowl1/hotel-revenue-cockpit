# copy to .env. only GF_SECURITY_ADMIN_PASSWORD and ADMIN_TOKEN are secrets: change both.
APP_NAME=Hotel Revenue Cockpit
PUBLIC_URL=http://localhost:8001
USER_AGENT=hotel-revenue-cockpit/1.0 (open source portfolio project)
HOTEL_CITY_LAT=38.7223
HOTEL_CITY_LON=-9.1393
HOTEL_RESORT_LAT=37.0194
HOTEL_RESORT_LON=-7.9304
REPLAY_SPEED=1.0
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
ADMIN_TOKEN=generate-a-long-random-string
# the container runs as your host user so that files it writes stay yours: echo LOCAL_UID=$(id -u) LOCAL_GID=$(id -g)
LOCAL_UID=1000
LOCAL_GID=1000
